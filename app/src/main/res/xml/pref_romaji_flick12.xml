<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/category_romaji_flick12_title">

        <Preference
            android:key="romaji_flick12_size_position_preference"
            android:title="@string/keyboard_layout_settings_title"
            android:summary="@string/keyboard_layout_settings_summary" />

        <Preference
            android:key="romaji_flick12_key_size_preference"
            android:title="@string/custom_keyboard_size_preference_title"
            app:summary="@string/custom_keyboard_size_preference_summary" />

        <Preference
            android:key="romaji_flick12_popup_style_preference"
            android:title="@string/flick_keyboard_popup_view_style_preference_title"
            android:summary="@string/flick_keyboard_popup_view_style_preference_summary" />

        <SeekBarPreference
            android:defaultValue="150"
            android:key="romaji_flick12_popup_delay_ms"
            android:max="600"
            android:title="@string/romaji_flick12_popup_delay_title"
            app:min="0"
            app:showSeekBarValue="true"
            app:summary="@string/romaji_flick12_popup_delay_summary" />

        <SwitchPreferenceCompat
            android:key="romaji_flick12_keymap_guide"
            android:title="@string/flick_keymap_guide_title"
            app:defaultValue="true"
            app:summary="@string/romaji_flick12_keymap_guide_summary" />

        <SwitchPreferenceCompat
            android:key="romaji_flick12_english_mode_enabled"
            android:title="@string/romaji_flick12_english_mode_title"
            app:defaultValue="true"
            app:summary="@string/romaji_flick12_english_mode_summary" />

        <ListPreference
            android:defaultValue="half_width_space"
            android:entries="@array/romaji_flick12_space_flick_entries"
            android:entryValues="@array/romaji_flick12_space_flick_values"
            android:key="romaji_flick12_space_up"
            android:title="@string/romaji_flick12_space_up_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="full_width_space"
            android:entries="@array/romaji_flick12_space_flick_entries"
            android:entryValues="@array/romaji_flick12_space_flick_values"
            android:key="romaji_flick12_space_left"
            android:title="@string/romaji_flick12_space_left_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="katakana"
            android:entries="@array/romaji_flick12_space_flick_entries"
            android:entryValues="@array/romaji_flick12_space_flick_values"
            android:key="romaji_flick12_space_down"
            android:title="@string/romaji_flick12_space_down_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:defaultValue="none"
            android:entries="@array/romaji_flick12_space_flick_entries"
            android:entryValues="@array/romaji_flick12_space_flick_values"
            android:key="romaji_flick12_space_right"
            android:title="@string/romaji_flick12_space_right_title"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:defaultValue="100"
            android:key="romaji_flick12_flick_sensitivity"
            android:max="200"
            android:title="@string/romaji_flick12_sensitivity_title"
            app:min="20"
            app:showSeekBarValue="true"
            app:summary="@string/romaji_flick12_sensitivity_summary" />

        <SwitchPreferenceCompat
            android:key="romaji_flick12_independent_multi_touch"
            android:title="@string/romaji_flick12_multi_touch_title"
            app:defaultValue="true"
            app:summary="@string/romaji_flick12_multi_touch_summary" />
    </PreferenceCategory>

</PreferenceScreen>
